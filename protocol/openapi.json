        ],
        "parameters": [
          {
            "in": "query",
            "name": "device",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "range",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "24h",
                "7d",
                "30d"
              ],
              "default": "1h"
            }
          }
        ]
      }
